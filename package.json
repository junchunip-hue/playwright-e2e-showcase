{
  "name": "playwright-e2e-showcase",
  "version": "0.1.0",
  "private": true,
  "description": "Production-style Playwright E2E + API test framework with CI/CD, targeting the public Practice Software Testing (Toolshop) demo app.",
  "scripts": {
    "test": "playwright test",
    "test:smoke": "playwright test --grep \"@smoke|@setup\"",
    "test:api": "playwright test --project=api",
    "test:ui": "playwright test --project=chromium",
    "test:a11y": "playwright test --project=chromium --grep \"@a11y|@setup\"",
    "test:visual": "playwright test --project=chromium --grep \"@visual|@setup\"",
    "report": "playwright show-report",
    "codegen": "playwright codegen https://practicesoftwaretesting.com",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.56.0",
    "@types/node": "^22.0.0",
    "dotenv": "^16.4.5",
    "eslint": "^9.0.0",
    "eslint-plugin-playwright": "^2.0.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0"
  }
}
