{
  "name": "playwright-e2e-showcase",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "description": "Playwright E2E and API tests for the Toolshop demo shop: scenarios written once in Gherkin, run in TypeScript (playwright-bdd) and Java (Cucumber-JVM), with CI against its own Toolshop.",
  "scripts": {
    "test": "bddgen && playwright test",
    "test:pr": "node scripts/run-suite.mjs pr --project=api --project=chromium",
    "test:smoke": "node scripts/run-suite.mjs smoke",
    "test:api": "bddgen && playwright test --project=api",
    "test:ui": "bddgen && playwright test --project=chromium",
    "test:a11y": "node scripts/run-suite.mjs a11y --project=chromium",
    "test:visual": "node scripts/run-suite.mjs visual --project=chromium",
    "test:architecture": "node scripts/run-suite.mjs architecture --project=architecture",
    "check:tags": "bddgen && playwright test --list --reporter=./src/reporters/tag-guard.ts",
    "report": "playwright show-report",
    "demo": "node scripts/demo.mjs",
    "codegen": "playwright codegen https://practicesoftwaretesting.com",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "bddgen": "bddgen"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.1",
    "@types/node": "^22.0.0",
    "dotenv": "^16.4.5",
    "eslint": "^9.0.0",
    "eslint-plugin-playwright": "^2.0.0",
    "playwright-bdd": "^9.2.1",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  }
}
