<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.showcase</groupId>
  <artifactId>playwright-e2e-showcase-java</artifactId>
  <version>0.1.0</version>
  <name>Playwright E2E Showcase (Java: Cucumber-JVM + JUnit 5)</name>
  <description>The Gherkin features shared with the TypeScript suite (../features), run with Playwright for Java and Cucumber-JVM on the JUnit Platform.</description>

  <properties>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <!-- Keep in step with @playwright/test in ../package.json -->
    <playwright.version>1.65.0</playwright.version>
    <junit.version>5.14.4</junit.version>
    <gson.version>2.15.0</gson.version>
    <!-- 7.x is the last line on JUnit 5 (8.x needs JUnit 6) -->
    <cucumber.version>7.34.9</cucumber.version>
    <!-- Where Surefire writes its XML; the PR's step dry run points it elsewhere (-Dsurefire.reportsDirectory=...). -->
    <surefire.reportsDirectory>${project.build.directory}/surefire-reports</surefire.reportsDirectory>
    <!-- Spotless: locally every build formats the code first; CI (profile below) only checks it. -->
    <spotless.apply.skip>false</spotless.apply.skip>
    <!--
      The failure controls (@control, C1 and C2: features/control) fails on purpose, so no ordinary run includes it. The
      nightly runs it on its own: -Dgroups=control -DexcludedGroups= (see .github/workflows/nightly-regression.yml).
    -->
    <excludedGroups>control</excludedGroups>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.junit</groupId>
        <artifactId>junit-bom</artifactId>
        <version>${junit.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>io.cucumber</groupId>
        <artifactId>cucumber-bom</artifactId>
        <version>${cucumber.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <dependency>
      <groupId>com.microsoft.playwright</groupId>
      <artifactId>playwright</artifactId>
      <version>${playwright.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- Gherkin: the features in ../features, shared with the TypeScript suite (com.showcase.RunCucumberTest) -->
    <dependency>
      <groupId>io.cucumber</groupId>
      <artifactId>cucumber-java</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.cucumber</groupId>
      <artifactId>cucumber-junit-platform-engine</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.cucumber</groupId>
      <artifactId>cucumber-picocontainer</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.platform</groupId>
      <artifactId>junit-platform-suite</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.google.code.gson</groupId>
      <artifactId>gson</artifactId>
      <version>${gson.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.16.0</version>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.6.1</version>
        <configuration>
          <reportsDirectory>${surefire.reportsDirectory}</reportsDirectory>
          <!-- Record scenario names ("U6: ...") in the XML reports, so the CI summary can match tests to IDs. -->
          <statelessTestsetReporter implementation="org.apache.maven.plugin.surefire.extensions.junit5.JUnit5Xml30StatelessReporter">
            <usePhrasedTestCaseMethodName>true</usePhrasedTestCaseMethodName>
          </statelessTestsetReporter>
        </configuration>
      </plugin>
      <!--
        Code style (docs/coding-rules.md): google-java-format (2-space indent, 100 columns, imports sorted static
        first and unused ones removed), no wildcard imports, LF and a final newline. Locally "./mvnw test" formats the
        sources before compiling them (spotless:apply); in CI the apply step is skipped and spotless:check fails the
        build on any unformatted file. Run it on its own with "./mvnw spotless:apply" or "npm run format".
      -->
      <plugin>
        <groupId>com.diffplug.spotless</groupId>
        <artifactId>spotless-maven-plugin</artifactId>
        <version>3.11.0</version>
        <configuration>
          <java>
            <googleJavaFormat/>
            <removeUnusedImports/>
            <forbidWildcardImports/>
            <trimTrailingWhitespace/>
            <endWithNewline/>
          </java>
        </configuration>
        <executions>
          <execution>
            <id>format</id>
            <phase>process-sources</phase>
            <goals>
              <goal>apply</goal>
            </goals>
          </execution>
          <execution>
            <id>check-format</id>
            <phase>process-sources</phase>
            <goals>
              <goal>check</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
      <!-- Runs Playwright's CLI, e.g. to install browsers: see docs/java.md "Run". -->
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <version>3.7.0</version>
        <configuration>
          <mainClass>com.microsoft.playwright.CLI</mainClass>
          <classpathScope>test</classpathScope>
        </configuration>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <!--
      In CI a failed test is rerun up to twice, like the TypeScript suite (playwright.config.ts: retries: isCI ? 2 : 0).
      A test that passes on a rerun is a flake: Surefire keeps the failed attempts as <flakyFailure>/<flakyError> in
      the XML, and the pipeline summary lists it as flaky. Locally a failure stays a failure.
    -->
    <profile>
      <id>ci-retries</id>
      <activation>
        <property>
          <name>env.CI</name>
        </property>
      </activation>
      <properties>
        <surefire.rerunFailingTestsCount>2</surefire.rerunFailingTestsCount>
        <!-- CI never rewrites code: an unformatted file fails spotless:check instead. -->
        <spotless.apply.skip>true</spotless.apply.skip>
      </properties>
    </profile>
  </profiles>
</project>
